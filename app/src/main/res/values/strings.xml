    <!-- Flood Info -->
    <string name="flood_before">Elevate belongings, monitor water levels, prepare go-bag with essentials.</string>
    <string name="flood_during">Switch off electricity, evacuate to higher ground, avoid walking/driving in flood water.</string>
    <string name="flood_after">Clean up debris safely, wait for clearance from officials, check for electrical hazards.</string>
    <string name="flood_centers">San Jose Elementary School, Antipolo City National HS.</string>
    <string name="flood_high_risk">Lower Main Gate, Sitio PAGASA, Kabisay, Bamban, San Josef.</string>

    <!-- Typhoon Info -->
    <string name="typhoon_before">Secure roof and windows, stock enough food and water, charge all emergency devices.</string>
    <string name="typhoon_during">Stay indoors, monitor news updates, stay away from glass windows and power lines.</string>
    <string name="typhoon_after">Inspect house for damage, avoid downed power lines, clear debris only when safe.</string>
    <string name="typhoon_centers">Ynares Center, San Jose Brgy Hall.</string>
    <string name="typhoon_high_risk">Entire low-lying areas of Brgy. San Jose.</string>

    <!-- Landslide Info -->
    <string name="landslide_before">Identify slope risks, monitor heavy rain, watch for cracks in the ground or leaning trees.</string>
    <string name="landslide_during">Evacuate immediately if signs occur, move to stable ground away from the slope.</string>
    <string name="landslide_after">Stay away from slide area, watch for secondary slides, check for injured persons nearby.</string>
    <string name="landslide_centers">San Jose Elementary School.</string>
    <string name="landslide_high_risk">Daang Pare, Hinapaw, Sitio San Isidro, Bamban.</string>

    <!-- Earthquake Info -->
    <string name="earthquake_before">Anchor heavy furniture, identify safe spots in every room, participate in regular drills.</string>
    <string name="earthquake_during">Drop, Cover, and Hold on. Stay away from glass, windows, and heavy objects.</string>
    <string name="earthquake_after">Expect aftershocks, check for gas leaks and injuries, evacuate to open spaces.</string>
    <string name="earthquake_centers">Designated open spaces and evacuation zones.</string>
    <string name="earthquake_high_risk">Structural safety checks recommended for old buildings and high-density areas.</string>

