<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_profile_gradient">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center_horizontal">

            <!-- Profile Header -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="60dp"
                android:layout_marginBottom="16dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivProfileImage"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:padding="2dp"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CornerSize50Percent"
                    app:strokeColor="@color/warning_orange"
                    app:strokeWidth="2dp"
                    android:src="@drawable/logog" />

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/fabEditProfileImage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    app:fabCustomSize="32dp"
                    app:maxImageSize="18dp"
                    app:srcCompat="@drawable/ic_edit"
                    app:tint="@color/white"
                    app:backgroundTint="@color/warning_orange"
                    android:contentDescription="Edit Photo" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvProfileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Juan Dela Cruz"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="2dp"/>

            <TextView
                android:id="@+id/tvProfilePosition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Barangay Chairman"
                android:textColor="@color/text_secondary"
                android:textSize="16sp"
                android:layout_marginBottom="2dp"/>

            <TextView
                android:id="@+id/tvProfileBarangay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Barangay San Jose"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:layout_marginBottom="16dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditProfile"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EDIT PROFILE"
                android:textColor="@color/text_primary"
                app:strokeColor="@color/gold_accent"
                app:cornerRadius="20dp"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/tvProfileAbout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Barangay Chairman"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginBottom="32dp"/>

            <!-- Actions Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:maxWidth="400dp">

                <!-- Chairman Specific Actions (Visible by default as shown in image) -->
                <LinearLayout
                    android:id="@+id/layoutChairmanActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnChairmanSendEmergencyAlert"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:text="SEND EMERGENCY ALERT"
                        android:backgroundTint="@color/warning_orange"
                        android:textColor="@color/black"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_alerts"
                        app:iconTint="@color/black"
                        app:iconPadding="12dp"
                        app:iconGravity="textStart"
                        android:layout_marginBottom="12dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnChairmanCreateAnnouncement"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:text="CREATE ANNOUNCEMENT"
                        android:backgroundTint="@color/surface"
                        android:textColor="@color/text_primary"
                        app:strokeColor="@color/gold_accent"
                        app:strokeWidth="1.5dp"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_preparedness"
                        app:iconTint="@color/text_primary"
                        app:iconPadding="12dp"
                        app:iconGravity="textStart"
                        android:layout_marginBottom="12dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnChairmanViewAnnouncements"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:text="VIEW ANNOUNCEMENTS"
                        android:backgroundTint="@color/surface"
                        android:textColor="@color/text_primary"
                        app:strokeColor="@color/gold_accent"
                        app:strokeWidth="1.5dp"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_chat"
                        app:iconTint="@color/text_primary"
                        app:iconPadding="12dp"
                        app:iconGravity="textStart"
                        android:layout_marginBottom="12dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnReportsApproval"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:text="REPORTS APPROVAL"
                        android:backgroundTint="@color/surface"
                        android:textColor="@color/text_primary"
                        app:strokeColor="@color/gold_accent"
                        app:strokeWidth="1.5dp"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_hotline"
                        app:iconTint="@color/text_primary"
                        app:iconPadding="12dp"
                        app:iconGravity="textStart"
                        android:layout_marginBottom="12dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnVerifyResidents"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:text="VERIFY RESIDENTS"
                        android:backgroundTint="@color/surface"
                        android:textColor="@color/text_primary"
                        app:strokeColor="@color/gold_accent"
                        app:strokeWidth="1.5dp"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_nav_placeholder"
                        app:iconTint="@color/text_primary"
                        app:iconPadding="12dp"
                        app:iconGravity="textStart"
                        android:layout_marginBottom="12dp"/>
                </LinearLayout>

                <!-- BDRRMO Actions (Hidden by default) -->
                <LinearLayout
                    android:id="@+id/layoutBdrrmoActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSendEmergencyAlert"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:text="SEND EMERGENCY ALERT"
                        android:backgroundTint="@color/warning_orange"
                        android:textColor="@color/black"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_alerts"
                        app:iconTint="@color/black"
                        app:iconPadding="12dp"
                        app:iconGravity="textStart"
                        android:layout_marginBottom="12dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCreateAnnouncement"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:text="CREATE ANNOUNCEMENT"
                        android:backgroundTint="@color/surface"
                        android:textColor="@color/text_primary"
                        app:strokeColor="@color/gold_accent"
                        app:strokeWidth="1.5dp"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_preparedness"
                        app:iconTint="@color/text_primary"
                        app:iconPadding="12dp"
                        app:iconGravity="textStart"
                        android:layout_marginBottom="12dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnViewAnnouncements"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:text="VIEW ANNOUNCEMENTS"
                        android:backgroundTint="@color/surface"
                        android:textColor="@color/text_primary"
                        app:strokeColor="@color/gold_accent"
                        app:strokeWidth="1.5dp"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_chat"
                        app:iconTint="@color/text_primary"
                        app:iconPadding="12dp"
                        app:iconGravity="textStart"
                        android:layout_marginBottom="12dp"/>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogout"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="LOGOUT"
                    android:backgroundTint="@color/emergency_red"
                    android:textColor="@color/white"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_logout"
                    app:iconTint="@color/white"
                    app:iconPadding="12dp"
                    app:iconGravity="textStart"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="40dp"/>

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>