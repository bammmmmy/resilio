<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_profile_gradient">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center_horizontal">

            <!-- Profile Header -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_marginTop="60dp"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="50dp"
                app:cardBackgroundColor="@color/warning_orange"
                app:cardElevation="8dp"
                app:strokeWidth="0dp">
                <!-- Solid gold circle as seen in the image -->
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvProfileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Barangay Chairman"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvProfileEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="email@example.com"
                android:textColor="@color/text_secondary"
                android:textSize="16sp"
                android:layout_marginBottom="32dp"/>

            <!-- Actions Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:maxWidth="400dp">

                <!-- Chairman Specific Actions (Visible by default as shown in image) -->
                <LinearLayout
                    android:id="@+id/layoutChairmanActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnChairmanSendEmergencyAlert"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:text="SEND EMERGENCY ALERT"
                        android:backgroundTint="@color/warning_orange"
                        android:textColor="@color/black"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_alerts"
                        app:iconTint="@color/black"
                        app:iconPadding="12dp"
                        app:iconGravity="textStart"
                        android:layout_marginBottom="12dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnChairmanCreateAnnouncement"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:text="CREATE ANNOUNCEMENT"
                        android:backgroundTint="@color/surface"
                        android:textColor="@color/text_primary"
                        app:strokeColor="@color/gold_accent"
                        app:strokeWidth="1.5dp"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_preparedness"
                        app:iconTint="@color/text_primary"
                        app:iconPadding="12dp"
                        app:iconGravity="textStart"
                        android:layout_marginBottom="12dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnChairmanViewAnnouncements"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:text="VIEW ANNOUNCEMENTS"
                        android:backgroundTint="@color/surface"
                        android:textColor="@color/text_primary"
                        app:strokeColor="@color/gold_accent"
                        app:strokeWidth="1.5dp"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_chat"
                        app:iconTint="@color/text_primary"
                        app:iconPadding="12dp"
                        app:iconGravity="textStart"
                        android:layout_marginBottom="12dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnReportsApproval"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:text="REPORTS APPROVAL"
                        android:backgroundTint="@color/surface"
                        android:textColor="@color/text_primary"
                        app:strokeColor="@color/gold_accent"
                        app:strokeWidth="1.5dp"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_hotline"
                        app:iconTint="@color/text_primary"
                        app:iconPadding="12dp"
                        app:iconGravity="textStart"
                        android:layout_marginBottom="12dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnVerifyResidents"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:text="VERIFY RESIDENTS"
                        android:backgroundTint="@color/surface"
                        android:textColor="@color/text_primary"
                        app:strokeColor="@color/gold_accent"
                        app:strokeWidth="1.5dp"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_nav_placeholder"
                        app:iconTint="@color/text_primary"
                        app:iconPadding="12dp"
                        app:iconGravity="textStart"
                        android:layout_marginBottom="12dp"/>
                </LinearLayout>

                <!-- BDRRMO Actions (Hidden by default) -->
                <LinearLayout
                    android:id="@+id/layoutBdrrmoActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSendEmergencyAlert"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:text="SEND EMERGENCY ALERT"
                        android:backgroundTint="@color/warning_orange"
                        android:textColor="@color/black"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_alerts"
                        app:iconTint="@color/black"
                        app:iconPadding="12dp"
                        app:iconGravity="textStart"
                        android:layout_marginBottom="12dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCreateAnnouncement"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:text="CREATE ANNOUNCEMENT"
                        android:backgroundTint="@color/surface"
                        android:textColor="@color/text_primary"
                        app:strokeColor="@color/gold_accent"
                        app:strokeWidth="1.5dp"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_preparedness"
                        app:iconTint="@color/text_primary"
                        app:iconPadding="12dp"
                        app:iconGravity="textStart"
                        android:layout_marginBottom="12dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnViewAnnouncements"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:text="VIEW ANNOUNCEMENTS"
                        android:backgroundTint="@color/surface"
                        android:textColor="@color/text_primary"
                        app:strokeColor="@color/gold_accent"
                        app:strokeWidth="1.5dp"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_chat"
                        app:iconTint="@color/text_primary"
                        app:iconPadding="12dp"
                        app:iconGravity="textStart"
                        android:layout_marginBottom="12dp"/>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogout"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="LOGOUT"
                    android:backgroundTint="@color/emergency_red"
                    android:textColor="@color/white"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_logout"
                    app:iconTint="@color/white"
                    app:iconPadding="12dp"
                    app:iconGravity="textStart"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="40dp"/>

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>