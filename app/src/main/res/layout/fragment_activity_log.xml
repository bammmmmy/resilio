<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="20dp" android:background="#F3F7FB">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Activity Log" android:textColor="#183A63" android:textSize="25sp" android:textStyle="bold" />
    <TextView android:id="@+id/tv_activity_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="32dp" android:gravity="center" android:text="No activity yet" android:textColor="#7890A7" android:visibility="gone" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_activity_log" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="16dp" />
</LinearLayout>