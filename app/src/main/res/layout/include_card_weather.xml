<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_weather"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardBackgroundColor="#F7FBFF"
    app:cardCornerRadius="11dp"
    app:cardElevation="7dp"
    app:strokeColor="#D5E1ED"
    app:strokeWidth="1dp">

    <FrameLayout
        android:id="@+id/layout_weather_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F7FBFF">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.62"
            android:contentDescription=""
            android:scaleType="centerCrop"
            android:src="@drawable/weatherbackground" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_weather_card_fade"
            android:padding="16dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_weather_loading"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="visible"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/weather_loading_spinner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminate="true"
                    app:indicatorColor="#378DE5"
                    app:indicatorSize="24dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:trackThickness="3dp" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_weather_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/iv_weather_icon"
                    android:layout_width="39dp"
                    android:layout_height="39dp"
                    android:background="@drawable/bg_weather_icon_blue"
                    android:contentDescription="Weather"
                    android:padding="9dp"
                    android:src="@drawable/ic_weather_cloud"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_weather_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="WEATHER"
                    android:textColor="#176CC1"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toEndOf="@id/iv_weather_icon"
                    app:layout_constraintTop_toTopOf="@id/iv_weather_icon" />

                <TextView
                    android:id="@+id/tv_weather_condition"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="2dp"
                    android:text="Clear sky"
                    android:textColor="#7890A7"
                    android:textSize="9sp"
                    app:layout_constraintStart_toEndOf="@id/iv_weather_icon"
                    app:layout_constraintTop_toBottomOf="@id/tv_weather_label" />

                <TextView
                    android:id="@+id/tv_weather_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:text="24°C"
                    android:textColor="#173D6E"
                    android:textSize="38sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/iv_weather_icon" />

                <LinearLayout
                    android:id="@+id/layout_weather_data"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:orientation="vertical"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_weather_temp">
                    <TextView
                        android:id="@+id/tv_weather_precip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Precipitation   --"
                        android:textColor="#7890A7"
                        android:textSize="9sp" />
                    <TextView
                        android:id="@+id/tv_weather_wind"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Wind speed   --"
                        android:textColor="#7890A7"
                        android:textSize="9sp" />
                    <TextView
                        android:id="@+id/tv_weather_humidity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Humidity   --"
                        android:textColor="#7890A7"
                        android:textSize="9sp" />
                    <TextView
                        android:id="@+id/tv_rain_24h"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="24h Rain   --"
                        android:textColor="#7890A7"
                        android:textSize="9sp"
                        android:visibility="visible" />
                    <TextView
                        android:id="@+id/tv_rain_intensity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Rain Intensity   --"
                        android:textColor="#7890A7"
                        android:textSize="9sp"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_weather_advisory"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#E8F3FF"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="7dp"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/layout_weather_data">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="7dp"
                        android:src="@drawable/ic_alerts"
                        app:tint="#D33F4C" />
                    <TextView
                        android:id="@+id/tv_weather_advisory"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="#A43E43"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_weather_source"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="8dp"
                    android:text="Updated from Open-Meteo"
                    android:textColor="#7890A7"
                    android:textSize="8sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/btn_weather_details"
                    app:layout_constraintStart_toStartOf="parent" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_weather_details"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginBottom="2dp"
                    android:minWidth="0dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="8dp"
                    android:text="View details"
                    android:textColor="#2178D0"
                    android:textSize="9sp"
                    app:backgroundTint="#F3F9FF"
                    app:cornerRadius="6dp"
                    app:icon="@drawable/ic_arrow_drop_down"
                    app:iconGravity="textEnd"
                    app:iconSize="12dp"
                    app:iconTint="#2178D0"
                    app:strokeColor="#8BB7E5"
                    app:strokeWidth="1dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <LinearLayout
                    android:id="@+id/layout_weather_right_side"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <TextView android:id="@+id/tv_weather_day" android:layout_width="1dp" android:layout_height="1dp" />
                    <TextView android:id="@+id/tv_weather_time" android:layout_width="1dp" android:layout_height="1dp" />
                    <TextView android:id="@+id/tv_weather_location" android:layout_width="1dp" android:layout_height="1dp" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
