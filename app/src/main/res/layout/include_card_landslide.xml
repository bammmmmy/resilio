<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_landslide"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardCornerRadius="20dp"
    app:cardElevation="4dp"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_landslide_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/secondary_blue"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_landslide_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LANDSLIDE RISK"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/iv_landslide_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:src="@drawable/ic_landslide"
            android:contentDescription="Landslide icon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_landslide_title"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/tv_landslide_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="LOW RISK"
            android:textColor="@color/white"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/iv_landslide_icon"
            app:layout_constraintStart_toEndOf="@id/iv_landslide_icon"
            app:layout_constraintTop_toTopOf="@id/iv_landslide_icon" />

        <TextView
            android:id="@+id/tv_landslide_desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Based on current rainfall data in Antipolo City. Stay alert for signs of ground movement."
            android:textColor="@color/white"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/iv_landslide_icon" />

        <LinearLayout
            android:id="@+id/layout_rainfall_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/tv_landslide_desc">

            <TextView
                android:id="@+id/tv_24h_rainfall"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="24h Rain: 0.0mm"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_soil_moisture"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Soil Saturation: Low"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:gravity="end" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
