<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_earthquake"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardBackgroundColor="#FBFAFF"
    app:cardCornerRadius="11dp"
    app:cardElevation="7dp"
    app:strokeColor="#D5E1ED"
    app:strokeWidth="1dp">

    <FrameLayout
        android:id="@+id/layout_earthquake_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FBFAFF">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.35"
            android:contentDescription=""
            android:scaleType="centerCrop"
            android:src="@drawable/earthquake_card_background" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_earthquake_image_fade"
            android:padding="16dp">

            <ImageView
                android:id="@+id/iv_earthquake_icon"
                android:layout_width="39dp"
                android:layout_height="39dp"
                android:background="@drawable/bg_earthquake_icon"
                android:contentDescription="Earthquake status"
                android:padding="9dp"
                android:src="@drawable/ic_alerts"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/tv_earthquake_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="EARTHQUAKE STATUS"
                android:textColor="#4D3CBD"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@id/iv_earthquake_icon"
                app:layout_constraintTop_toTopOf="@id/iv_earthquake_icon" />

            <TextView
                android:id="@+id/tv_earthquake_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="2dp"
                android:text="affecting the area"
                android:textColor="#7890A7"
                android:textSize="9sp"
                app:layout_constraintStart_toEndOf="@id/iv_earthquake_icon"
                app:layout_constraintTop_toBottomOf="@id/tv_earthquake_title" />

            <TextView
                android:id="@+id/tv_earthquake_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:background="@drawable/bg_earthquake_status"
                android:paddingStart="13dp"
                android:paddingTop="9dp"
                android:paddingEnd="13dp"
                android:paddingBottom="9dp"
                android:text="No recent earthquake"
                android:textColor="#137D58"
                android:textSize="10sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/iv_earthquake_icon" />

            <LinearLayout
                android:id="@+id/layout_earthquake_stats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/tv_earthquake_status">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.8"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Magnitude" android:textColor="#7890A7" android:textSize="8sp" />
                    <TextView android:id="@+id/tv_latest_mag" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="--" android:textColor="#315678" android:textSize="10sp" android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.35"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Location" android:textColor="#7890A7" android:textSize="8sp" />
                    <TextView android:id="@+id/tv_quake_distance" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:ellipsize="end" android:maxLines="1" android:text="--" android:textColor="#315678" android:textSize="10sp" android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.7"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Time" android:textColor="#7890A7" android:textSize="8sp" />
                    <TextView android:id="@+id/tv_quake_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="--" android:textColor="#315678" android:textSize="10sp" android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:text="Source: USGS Earthquake Hazards"
                android:textColor="#7890A7"
                android:textSize="8sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
