<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background_dark"
        app:elevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/emergency_contacts_title"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap any number to call immediately"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="4dp"/>
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingBottom="40dp">

            <!-- Brgy San Jose -->
            <TextView
                style="@style/CategoryHeader"
                android:text="@string/label_brgy_san_jose_pro" />

            <com.google.android.material.card.MaterialCardView style="@style/EmergencyCard">
                <LinearLayout style="@style/EmergencyCardContent">
                    <include layout="@layout/item_contact_row" android:id="@+id/row_brgy_1" />
                    <View style="@style/RowDivider" />
                    <include layout="@layout/item_contact_row" android:id="@+id/row_brgy_2" />
                    <View style="@style/RowDivider" />
                    <include layout="@layout/item_contact_row" android:id="@+id/row_brgy_3" />
                    <View style="@style/RowDivider" />
                    <include layout="@layout/item_contact_row" android:id="@+id/row_brgy_4" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- CDRRMO -->
            <TextView
                style="@style/CategoryHeader"
                android:text="@string/label_cdrrmo_antipolo_pro" />

            <com.google.android.material.card.MaterialCardView style="@style/EmergencyCard">
                <LinearLayout style="@style/EmergencyCardContent">
                    <include layout="@layout/item_contact_row" android:id="@+id/row_cdrrmo_1" />
                    <View style="@style/RowDivider" />
                    <include layout="@layout/item_contact_row" android:id="@+id/row_cdrrmo_2" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Police -->
            <TextView
                style="@style/CategoryHeader"
                android:text="@string/label_police_pro" />

            <com.google.android.material.card.MaterialCardView style="@style/EmergencyCard">
                <LinearLayout style="@style/EmergencyCardContent">
                    <include layout="@layout/item_contact_row" android:id="@+id/row_police_1" />
                    <View style="@style/RowDivider" />
                    <include layout="@layout/item_contact_row" android:id="@+id/row_police_2" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Fire -->
            <TextView
                style="@style/CategoryHeader"
                android:text="@string/label_fire_department_pro" />

            <com.google.android.material.card.MaterialCardView style="@style/EmergencyCard">
                <LinearLayout style="@style/EmergencyCardContent">
                    <include layout="@layout/item_contact_row" android:id="@+id/row_fire_1" />
                    <View style="@style/RowDivider" />
                    <include layout="@layout/item_contact_row" android:id="@+id/row_fire_2" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Medical -->
            <TextView
                style="@style/CategoryHeader"
                android:text="@string/label_ambulance_pro" />

            <com.google.android.material.card.MaterialCardView style="@style/EmergencyCard">
                <LinearLayout style="@style/EmergencyCardContent">
                    <include layout="@layout/item_contact_row" android:id="@+id/row_medical_1" />
                    <View style="@style/RowDivider" />
                    <include layout="@layout/item_contact_row" android:id="@+id/row_medical_2" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_back_home"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Back to Home"
                android:layout_marginTop="24dp"
                app:cornerRadius="12dp"
                android:backgroundTint="@color/divider_color"
                android:textColor="@color/white"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
